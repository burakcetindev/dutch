# ⚠️  SECURITY NOTICE:
# This file contains example values for local development only.
# For production, change these credentials and NEVER commit your .env file to version control.
# Your .env and .env.local files are already in .gitignore.

# Database Configuration
POSTGRES_USER=your_database_username
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=dutch_vocabulary
POSTGRES_PORT=5432

# Application Configuration
APP_PORT=3000

# Database URL (for local development)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://your_database_username:your_secure_password_here@localhost:5432/dutch_vocabulary
